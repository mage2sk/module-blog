<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Panth_Blog::all" title="Panth Blog" translate="title" sortOrder="100">
                    <resource id="Panth_Blog::post" title="Posts" translate="title" sortOrder="10">
                        <resource id="Panth_Blog::post_save" title="Save Post" translate="title" sortOrder="10"/>
                        <resource id="Panth_Blog::post_delete" title="Delete Post" translate="title" sortOrder="20"/>
                    </resource>
                    <resource id="Panth_Blog::category" title="Categories" translate="title" sortOrder="20">
                        <resource id="Panth_Blog::category_save" title="Save Category" translate="title" sortOrder="10"/>
                        <resource id="Panth_Blog::category_delete" title="Delete Category" translate="title" sortOrder="20"/>
                    </resource>
                    <resource id="Panth_Blog::tag" title="Tags" translate="title" sortOrder="30">
                        <resource id="Panth_Blog::tag_save" title="Save Tag" translate="title" sortOrder="10"/>
                        <resource id="Panth_Blog::tag_delete" title="Delete Tag" translate="title" sortOrder="20"/>
                    </resource>
                    <resource id="Panth_Blog::author" title="Authors" translate="title" sortOrder="40">
                        <resource id="Panth_Blog::author_save" title="Save Author" translate="title" sortOrder="10"/>
                        <resource id="Panth_Blog::author_delete" title="Delete Author" translate="title" sortOrder="20"/>
                    </resource>
                    <resource id="Panth_Blog::comment" title="Comments" translate="title" sortOrder="50"/>
                    <resource id="Panth_Blog::config" title="Configuration" translate="title" sortOrder="60"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
