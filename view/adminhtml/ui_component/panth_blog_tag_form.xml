<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">panth_blog_tag_form.panth_blog_tag_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Tag Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Panth\Blog\Block\Adminhtml\Tag\Edit\Button\Back"/>
            <button name="save" class="Panth\Blog\Block\Adminhtml\Tag\Edit\Button\Save"/>
            <button name="save_and_continue" class="Panth\Blog\Block\Adminhtml\Tag\Edit\Button\SaveAndContinue"/>
            <button name="reset" class="Panth\Blog\Block\Adminhtml\Tag\Edit\Button\Reset"/>
            <button name="delete" class="Panth\Blog\Block\Adminhtml\Tag\Edit\Button\Delete"/>
        </buttons>
        <namespace>panth_blog_tag_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>panth_blog_tag_form.panth_blog_tag_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="panth_blog_tag_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="Panth\Blog\Model\Tag\DataProvider" name="panth_blog_tag_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>tag_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="tag_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>tag_id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input">
            <settings>
                <label translate="true">Name</label>
                <dataType>text</dataType>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="url_key" formElement="input">
            <settings>
                <label translate="true">URL Key</label>
                <dataType>text</dataType>
                <dataScope>url_key</dataScope>
            </settings>
        </field>
        <field name="description" formElement="textarea">
            <settings>
                <label translate="true">Description</label>
                <dataType>text</dataType>
                <dataScope>description</dataScope>
            </settings>
        </field>
        <field name="meta_robots" formElement="input">
            <settings>
                <label translate="true">Meta Robots</label>
                <dataType>text</dataType>
                <dataScope>meta_robots</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
