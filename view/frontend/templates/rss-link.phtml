<?php
declare(strict_types=1);
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
$viewModel = $block->getData('view_model');
if ($viewModel && method_exists($viewModel, 'isFeedAvailable') && !$viewModel->isFeedAvailable()) {
    return;
}
$front = $viewModel && method_exists($viewModel, 'getRouteFrontName')
    ? (string) $viewModel->getRouteFrontName()
    : 'blog';
$rssUrl = $block->getUrl('', ['_direct' => $front . '/feed.xml']);
?>
<link rel="alternate" type="application/rss+xml" href="<?= $escaper->escapeUrl($rssUrl) ?>"/>
