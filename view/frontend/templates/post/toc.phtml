<?php
declare(strict_types=1);
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
$toc = (array)$block->getData('toc');
if (empty($toc)) {
    return;
}
?>
<nav class="pb-toc" aria-label="<?= $escaper->escapeHtmlAttr(__('Table of contents')) ?>">
    <p class="pb-toc__title"><?= $escaper->escapeHtml(__('On this page')) ?></p>
    <ol class="pb-toc__list">
        <?php foreach ($toc as $item):
            $level = (int)($item['level'] ?? 2);
            $anchor = (string)($item['anchor'] ?? '');
            $text = (string)($item['text'] ?? '');
            if ($anchor === '' || $text === '') {
                continue;
            }
            ?>
            <li class="pb-toc__item pb-toc__item--level-<?= (int)$level ?>">
                <a href="#<?= $escaper->escapeHtmlAttr($anchor) ?>">
                    <?= $escaper->escapeHtml($text) ?>
                </a>
            </li>
        <?php endforeach; ?>
    </ol>
</nav>
