<?php
declare(strict_types=1);
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
$action = '/newsletter/subscriber/new/';
$viewModel = $block->getData('view_model');
$front = $viewModel && method_exists($viewModel, 'getRouteFrontName')
    ? (string) $viewModel->getRouteFrontName()
    : 'blog';
$rss = '/' . $front . '/feed.xml';
$showRss = !$viewModel || !method_exists($viewModel, 'isFeedAvailable') || $viewModel->isFeedAvailable();
?>
<section class="pb-sidebar__widget pb-sidebar__widget--subscribe">
    <h3 class="pb-sidebar__widget-title"><?= $escaper->escapeHtml(__('Subscribe')) ?></h3>
    <p class="pb-subscribe__copy"><?= $escaper->escapeHtml(__('Get new posts in your inbox.')) ?></p>
    <form class="pb-subscribe-form" method="post" action="<?= $escaper->escapeUrl($action) ?>">
        <?= $block->getBlockHtml('formkey') ?>
        <input class="pb-subscribe-form__input" type="email" name="email" required autocomplete="email" aria-label="<?= $escaper->escapeHtmlAttr(__('Email address')) ?>" placeholder="<?= $escaper->escapeHtmlAttr(__('your@email.com')) ?>"/>
        <button class="pb-subscribe-form__btn pb-btn pb-btn--primary" type="submit">
            <?= $escaper->escapeHtml(__('Subscribe')) ?>
        </button>
    </form>
    <?php if ($showRss): ?>
    <a class="pb-subscribe__rss" href="<?= $escaper->escapeUrl($rss) ?>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:14px;height:14px;flex-shrink:0;vertical-align:-2px;">
            <path d="M6.18 15.64a2.18 2.18 0 012.18 2.18C8.36 19 7.38 20 6.18 20A2.18 2.18 0 014 17.82a2.18 2.18 0 012.18-2.18M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"/>
        </svg>
        <?= $escaper->escapeHtml(__('RSS feed')) ?>
    </a>
    <?php endif; ?>
</section>
