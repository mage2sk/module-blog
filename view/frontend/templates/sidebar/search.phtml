<?php
declare(strict_types=1);
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
$viewModel = $block->getData('view_model');
$front = $viewModel && method_exists($viewModel, 'getRouteFrontName')
    ? (string) $viewModel->getRouteFrontName()
    : 'blog';
$action = '/' . $front . '/search';
?>
<section class="pb-sidebar__widget pb-sidebar__widget--search">
    <h3 class="pb-sidebar__widget-title"><?= $escaper->escapeHtml(__('Search')) ?></h3>
    <form class="pb-search-form" method="get" action="<?= $escaper->escapeUrl($action) ?>">
        <input type="search" name="q" aria-label="<?= $escaper->escapeHtmlAttr(__('Search posts')) ?>" placeholder="<?= $escaper->escapeHtmlAttr(__('Search posts...')) ?>"/>
        <button type="submit" aria-label="<?= $escaper->escapeHtmlAttr(__('Search')) ?>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:14px;height:14px;flex-shrink:0;">
                <circle cx="11" cy="11" r="7"/>
                <line x1="21" y1="21" x2="16.5" y2="16.5"/>
            </svg>
        </button>
    </form>
</section>
